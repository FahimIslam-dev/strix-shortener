{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Run Live Server (FastAPI)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": true,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Uvicorn running on (http://\\S+)",
                "uriFormat": "http://localhost:8000"
            }
        }
    ]
}
