{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Start Live Server (FastAPI Uvicorn)",
            "type": "shell",
            "command": "./venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Started reloader process",
                    "endsPattern": "Application startup complete"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": false
            }
        }
    ]
}
